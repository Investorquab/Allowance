# ─── Mode ─────────────────────────────────────────────
# sim  = offline (simulated Sui ledger + local memory) — for building and rehearsing
# live = Sui mainnet via Tatum + Walrus Memory mainnet — REQUIRED to qualify for Total Recall
ALLOWANCE_MODE=sim
ALLOWANCE_BASE_URL=http://localhost:3000

# ─── Tatum (dashboard.tatum.io) ───────────────────────
TATUM_API_KEY=
SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# ─── Money ────────────────────────────────────────────
# Agent wallet private key (suiprivkey1…). Use a FRESH wallet holding only a few dollars.
# Never commit this file, never paste the key into any chat. If it leaks, move the funds and make a new one.
AGENT_SUI_PRIVATE_KEY=
# Where vendor payments go (a second wallet you control)
VENDOR_SUI_ADDRESS=
# Optional: a third wallet for the DataPulse vendor (defaults to VENDOR_SUI_ADDRESS)
VENDOR2_SUI_ADDRESS=
# Native USDC on Sui — VERIFY before going live
USDC_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# ─── Walrus Memory (memory.walrus.xyz) ────────────────
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=allowance

# ─── Hard limits (USDC base units, 6 decimals) — memory can never raise these ─
HARD_PER_PAYMENT=1000000
HARD_DAILY=5000000
LEARN_AFTER_APPROVALS=2
